{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Leapsofts ERP",
  "version": "0.1.2",
  "identifier": "com.leapsofts.erp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM3RkU1QjA0QkU2ODZDRgpSV1RQaHVaTHNPVi9BeFpXTEg0NGYwRGsrbEVEWTczaWMrNFAwbHd4dGpzSUQ1UExaMWhEcjNmUAo=",
      "endpoints": [
        "https://github.com/aliroohan/leapsofts-desktop-app/releases/latest/download/latest.json"
      ]
    }
  }
}
